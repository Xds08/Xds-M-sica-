
<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1">
<title>XDS MÚSICA - Conectado Você Ao Mundo</title>
<style>
:root{--red:#ff0a2e;--blue:#00a6ff;--white:#fff;--bg:#050712}
*{margin:0;padding:0;box-sizing:border-box;font-family:Segoe UI,system-ui}
body{background:#000;display:flex;justify-content:center}
.app{width:100%;max-width:480px;background:var(--bg);min-height:100dvh;display:flex;flex-direction:column;border:1px solid #111;box-shadow:0 0 60px var(--red)}
.header{height:72px;background:linear-gradient(90deg,var(--red),var(--blue));display:flex;align-items:center;gap:10px;padding:0 14px;box-shadow:0 0 25px var(--red);position:sticky;top:0;z-index:20}
.logo{width:48px;height:48px;border-radius:14px;background:#000;display:grid;place-items:center;font-weight:900;font-size:22px;border:2px solid #fff;box-shadow:0 0 12px #fff}
.playerBox{margin:14px;background:#0d0f1e;border:2px solid var(--red);border-radius:22px;padding:16px;box-shadow:0 0 35px var(--red);text-align:center}
.vu{height:46px;display:flex;align-items:end;justify-content:center;gap:5px;margin:14px 0}
.bar{width:7px;background:linear-gradient(var(--red),var(--blue),var(--white));border-radius:99px;animation:wave .6s infinite alternate}
@keyframes wave{0%{height:8px}100%{height:44px}}
audio{width:100%;margin-top:12px;border-radius:12px}
.btnLive{background:linear-gradient(90deg,var(--red),var(--blue));border:none;color:#fff;padding:14px;border-radius:30px;width:100%;font-weight:900;margin-top:12px;cursor:pointer;box-shadow:0 0 20px var(--red);font-size:14px}
.pedidos{margin:14px;background:#10101a;border-radius:16px;padding:14px;border:1px solid #222}
.pedidos input{width:100%;padding:13px;border-radius:12px;border:1px solid var(--blue);background:#000;color:#fff;outline:none;margin:6px 0;font-size:14px}
.itemPed{padding:11px;border-bottom:1px solid #222;font-size:13px;display:flex;justify-content:space-between;align-items:center;color:#ddd}
.itemPed.dono{border-left:4px solid var(--red);background:linear-gradient(90deg,#1a0a0f,#10101a);color:#fff}
#btnDono{background:#000;color:var(--red);border:1.5px solid var(--red);padding:8px 14px;border-radius:20px;font-size:11px;font-weight:900;cursor:pointer;margin-left:auto;box-shadow:0 0 10px #ff0a2e55}
#btnDono.on{background:var(--red);color:#fff;box-shadow:0 0 18px var(--red)}
</style>
</head>
<body>
<div class="app">
<div class="header"><div class="logo">XM</div><div><b style="font-size:16px;letter-spacing:.5px">XDS MÚSICA</b><div style="font-size:9px;font-weight:700">Conectado Você Ao Mundo</div></div><button id="btnDono">👑 DONO</button></div>

<div class="playerBox">
<h2 style="color:var(--red);text-shadow:0 0 12px var(--red);letter-spacing:1px">XDS MÚSICA</h2>
<p style="color:var(--blue);font-size:11px;letter-spacing:1px;margin-top:2px">VERMELHO • BRANCO • AZUL NEON</p>
<div class="vu"><div class="bar" style="animation-delay:.1s"></div><div class="bar" style="animation-delay:.2s"></div><div class="bar" style="animation-delay:.3s"></div><div class="bar" style="animation-delay:.1s"></div><div class="bar" style="animation-delay:.4s"></div><div class="bar" style="animation-delay:.2s"></div><div class="bar" style="animation-delay:.3s"></div></div>
<div id="status" style="color:#fff;font-weight:800;font-size:14px">🔴 AO VIVO 24 HORAS</div>
<audio id="player" controls autoplay>
<source id="src" src="https://stream.zeno.fm/0r0xa8k8k8zuv" type="audio/mpeg">
</audio>
<button class="btnLive" id="btnGoLive">🎙️ ENTRAR AO VIVO COMO DONO</button>
<div style="margin-top:8px;font-size:10px;color:#555">LINK ATUAL: <span id="linkTxt" style="color:#888">zeno.fm - troque no painel</span></div>
</div>

<div id="painelDono" style="display:none;margin:14px;background:#000;border:2px solid var(--red);border-radius:16px;padding:14px;box-shadow:0 0 30px var(--red)">
<b style="color:var(--red);font-size:14px">👑 PAINEL DO DONO - XDS MÚSICA</b>
<div style="font-size:11px;color:#888;margin:4px 0 10px">Só você vê isso. Senha: XDS2024</div>
<div style="display:flex;flex-direction:column;gap:8px">
<button id="btnMudarLink" style="padding:13px;border-radius:11px;background:var(--blue);color:#fff;border:none;font-weight:900;cursor:pointer">🔗 Mudar link da rádio (Zeno)</button>
<button id="btnMudarSenha" style="padding:13px;border-radius:11px;background:#fff;color:#000;border:none;font-weight:900;cursor:pointer">🔑 Mudar minha senha de dono</button>
<button id="btnLimpar" style="padding:13px;border-radius:11px;background:#1a1a1a;color:#fff;border:1px solid #333;cursor:pointer">🗑️ Limpar todos os pedidos</button>
<button id="btnSairDono" style="padding:13px;border-radius:11px;background:#222;color:#777;border:none;cursor:pointer">Sair do modo dono</button>
</div>
</div>

<div class="pedidos">
<b style="color:var(--blue)">🎵 PEÇA SUA MÚSICA NA XDS MÚSICA</b>
<input id="nomePed" placeholder="Seu nome (ex: Paulo)">
<input id="musicaPed" placeholder="Música (ex: Ana Castela - Solteiro Forçado)">
<button class="btnLive" id="btnPedir" style="background:#fff;color:#000;box-shadow:none">ENVIAR PEDIDO 🔊</button>
<div id="listPed" style="margin-top:14px;max-height:320px;overflow:auto"></div>
</div>

<div style="text-align:center;padding:14px;font-size:10px;color:#444">XDS MÚSICA - Conectado Você Ao Mundo<br>Vermelho Branco Azul Neon</div>
</div>

<script type="module">
import{initializeApp}from"https://www.gstatic.com/firebasejs/10.12.0/firebase-app.js";
import{getFirestore,collection,addDoc,onSnapshot,query,orderBy,serverTimestamp,getDocs,deleteDoc,doc}from"https://www.gstatic.com/firebasejs/10.12.0/firebase-firestore.js";
let SENHA_DONO = localStorage.getItem("xds_senha") || "XDS2024";
const cfg={apiKey:"AIzaSyDnjiFQtTu8A5vZ3NHEIl_zG9ylMKTv6b8",authDomain:"talkxds.firebaseapp.com",projectId:"talkxds",storageBucket:"talkxds.firebasestorage.app",messagingSenderId:"757013602887",appId:"1:757013602887:web:6627ff87623d698e7d8762"};
const appF=initializeApp(cfg);const db=getFirestore(appF);
let isDono=localStorage.getItem("tx_dono")==="1";
function atualizaBtnDono(){const b=document.getElementById("btnDono");if(isDono){b.textContent="👑 DONO ON";b.classList.add("on");document.getElementById("painelDono").style.display="block";}else{b.textContent="👑 DONO";b.classList.remove("on");document.getElementById("painelDono").style.display="none";}}
atualizaBtnDono();
document.getElementById("linkTxt").textContent=localStorage.getItem("tx_radio_link")||"https://stream.zeno.fm/0r0xa8k8k8zuv";
const savedLink=localStorage.getItem("tx_radio_link");if(savedLink){document.getElementById("src").src=savedLink;document.getElementById("linkTxt").textContent=savedLink;}
document.getElementById("btnDono").onclick=()=>{
 if(isDono){const p=document.getElementById("painelDono");p.style.display=p.style.display==="none"?"block":"none";return;}
 let s=prompt(`Digite a senha de DONO da XDS MÚSICA:\nSenha atual: ${SENHA_DONO}`);if(s===SENHA_DONO){isDono=true;localStorage.setItem("tx_dono","1");alert("👑 Bem-vindo DONO da XDS MÚSICA!");atualizaBtnDono();}else if(s!==null){alert("Senha errada! Senha correta é: "+SENHA_DONO);}
};
document.getElementById("btnSairDono").onclick=()=>{isDono=false;localStorage.removeItem("tx_dono");atualizaBtnDono();alert("Saiu do modo dono");};
document.getElementById("btnMudarLink").onclick=()=>{let l=prompt("Cole seu link do Zeno.fm da rádio XDS MÚSICA:","https://stream.zeno.fm/");if(l){document.getElementById("src").src=l;document.getElementById("player").load();document.getElementById("player").play();localStorage.setItem("tx_radio_link",l);document.getElementById("linkTxt").textContent=l;document.getElementById("status").textContent="🔴 XDS MÚSICA AO VIVO";}};
document.getElementById("btnMudarSenha").onclick=()=>{let n=prompt("Digite nova senha de dono:","");if(n&&n.length>=4){SENHA_DONO=n;localStorage.setItem("xds_senha",n);alert("Senha nova salva: "+n);}else{alert("Senha precisa ter 4 letras no mínimo");}};
document.getElementById("btnGoLive").onclick=()=>{if(!isDono){alert("Só o DONO pode entrar ao vivo. Clique em 👑 DONO e digite sua senha.");return;}window.open("https://zeno.fm/broadcasting","_blank");alert("XDS MÚSICA - AO VIVO:\n1. Login no Zeno.fm\n2. Clique GO LIVE\n3. Selecione Microfone\n4. Fale - todos escutam!");};
document.getElementById("btnPedir").onclick=async()=>{
 const nome=document.getElementById("nomePed").value||"Ouvinte";
 const musica=document.getElementById("musicaPed").value.trim();
 if(!musica)return alert("Digite a música!");
 const tag=isDono?"👑 DONO XDS MÚSICA":"🎵";
 await addDoc(collection(db,"pedidos_xds_musica"),{nome:`${tag} ${nome}`,musica,hora:serverTimestamp(),dono:isDono});
 document.getElementById("musicaPed").value="";alert("Pedido enviado pra XDS MÚSICA!");
};
document.getElementById("btnLimpar").onclick=async()=>{
 if(!isDono)return;if(!confirm("Apagar todos os pedidos da XDS MÚSICA?"))return;
 const snap=await getDocs(collection(db,"pedidos_xds_musica"));for(const d of snap.docs){await deleteDoc(doc(db,"pedidos_xds_musica",d.id));}
};
const q=query(collection(db,"pedidos_xds_musica"),orderBy("hora","desc"));
onSnapshot(q,s=>{
 const list=document.getElementById("listPed");list.innerHTML="";
 s.forEach(d=>{
  const m=d.data();const div=document.createElement("div");div.className="itemPed"+(m.dono?" dono":"");
  div.innerHTML=`<span><b>${m.nome}</b><br><span style="color:${m.dono?'var(--red)':'#aaa'}">${m.musica}</span></span><span>${m.dono?'👑':'🔊'}</span>`;
  list.appendChild(div);
 });
 if(s.empty){list.innerHTML='<div style="text-align:center;color:#444;padding:22px">Nenhum pedido ainda na XDS MÚSICA.<br>Seja o primeiro ouvinte!</div>';}
});
</script>
</body>
</html>
